set -euo pipefail

PORT=1337
HTML_FILE="/tmp/nexus_weapon_lab.html"

echo -e "\033[1;31m╔══════════════════════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;31m║   NEXUS BALLISTICS LAB — WEAPON PROTOTYPING ENGINE           ║\033[0m"
echo -e "\033[1;31m╚══════════════════════════════════════════════════════════════╝\033[0m"

cat > "$HTML_FILE" << 'HTML_EOF'
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nexus Ballistics Lab</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #05050a; font-family: monospace; color: white; }
        #ui { position: absolute; top: 20px; left: 20px; pointer-events: none; background: rgba(0,0,0,0.6); padding: 15px; border: 1px solid #ff00c8; border-radius: 5px; box-shadow: 0 0 15px rgba(255,0,200,0.3); }
        #ui h1 { margin: 0 0 10px 0; font-size: 1.2rem; color: #ff00c8; text-shadow: 0 0 5px #ff00c8; }
        #ui p { margin: 2px 0; font-size: 0.85rem; color: #00e5ff; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 20px; height: 20px; transform: translate(-50%, -50%); pointer-events: none; }
        #crosshair::before, #crosshair::after { content: ''; position: absolute; background: #ff00c8; box-shadow: 0 0 5px #ff00c8; }
        #crosshair::before { top: 9px; left: 0; width: 20px; height: 2px; }
        #crosshair::after { top: 0; left: 9px; width: 2px; height: 20px; }
        
        #instructions { position: absolute; bottom: 20px; width: 100%; text-align: center; color: #fff; opacity: 0.7; pointer-events: none; font-size: 0.9rem; letter-spacing: 1px; }
        
        #explosion-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle, #ffaa00, transparent); opacity: 0; pointer-events: none; transition: opacity 0.1s; mix-blend-mode: screen; }
    </style>
</head>
<body>
    <div id="ui">
        <h1>NEXUS ARMORY</h1>
        <p>ARME : [1] Assault Precision / [2] Bazooka</p>
        <p id="ammo">MUNITIONS : ∞</p>
        <p id="status">STATUT : Prêt</p>
    </div>
    <div id="crosshair"></div>
    <div id="instructions">CLIC GAUCHE pour tirer | CLIC DROIT pour zoomer | ESPACE pour recharger</div>
    <div id="explosion-overlay"></div>

    <!-- Injection de Three.js via CDN pour le rendu 3D -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script>
        let scene, camera, renderer;
        let weaponGroup, currentWeapon = 'rifle';
        let bullets = [];
        let muzzleFlash;
        const raycaster = new THREE.Raycaster();
        const targetBoxes = [];
        
        // Paramètres balistiques
        const WEAPON_STATS = {
            rifle: { speed: 300, damage: 25, fireRate: 100, recoil: 0.02, color: 0x00e5ff, size: 0.5 },
            bazooka: { speed: 50, damage: 100, fireRate: 1000, recoil: 0.1, color: 0xff00c8, size: 2.0 }
        };
        
        let lastShotTime = 0;

        function init() {
            // 1. Scène
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x05050a, 0.02);

            // 2. Caméra
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 2, 5);

            // 3. Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.body.appendChild(renderer.domElement);

            // 4. Lumières
            const ambientLight = new THREE.AmbientLight(0x404040, 2);
            scene.add(ambientLight);
            
            const dirLight = new THREE.DirectionalLight(0xffffff, 1);
            dirLight.position.set(10, 20, 10);
            dirLight.castShadow = true;
            scene.add(dirLight);

            const pointLight = new THREE.PointLight(0xff00c8, 2, 20);
            pointLight.position.set(0, 5, 0);
            scene.add(pointLight);

            // 5. Environnement (Grille et Sol)
            const gridHelper = new THREE.GridHelper(100, 100, 0xff00c8, 0x222233);
            scene.add(gridHelper);

            const planeGeo = new THREE.PlaneGeometry(100, 100);
            const planeMat = new THREE.MeshStandardMaterial({ color: 0x0a0a14, roughness: 0.8 });
            const plane = new THREE.Mesh(planeGeo, planeMat);
            plane.rotation.x = -Math.PI / 2;
            plane.receiveShadow = true;
            scene.add(plane);

            // 6. Création des cibles (Sphères rouges)
            const targetGeo = new THREE.SphereGeometry(1, 32, 32);
            const targetMat = new THREE.MeshStandardMaterial({ color: 0xff3333, emissive: 0x330000 });
            for (let i = 0; i < 20; i++) {
                const target = new THREE.Mesh(targetGeo, targetMat);
                target.position.set(
                    (Math.random() - 0.5) * 40, 
                    Math.random() * 10 + 1, 
                    (Math.random() - 0.5) * 40 - 10
                );
                target.castShadow = true;
                target.userData = { health: 100 };
                targetBoxes.push(target);
                scene.add(target);
            }

            // 7. Création du Muzzle Flash
            const flashGeo = new THREE.SphereGeometry(0.2, 8, 8);
            const flashMat = new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0 });
            muzzleFlash = new THREE.Mesh(flashGeo, flashMat);
            camera.add(muzzleFlash);
            muzzleFlash.position.set(0.3, -0.3, -1);
            scene.add(camera);

            // 8. Création de l'arme (Proxy 3D simple)
            createWeaponModel();

            // 9. Événements
            window.addEventListener('resize', onWindowResize);
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mousedown', onMouseDown);
            document.addEventListener('keydown', onKeyDown);

            animate();
        }

        function createWeaponModel() {
            if (weaponGroup) scene.remove(weaponGroup);
            
            weaponGroup = new THREE.Group();
            
            if (currentWeapon === 'rifle') {
                // Corps du fusil
                const bodyGeo = new THREE.BoxGeometry(0.2, 0.2, 1.5);
                const bodyMat = new THREE.MeshStandardMaterial({ color: 0x333333, metalness: 0.8, roughness: 0.2 });
                const body = new THREE.Mesh(bodyGeo, bodyMat);
                body.position.set(0, 0, -0.5);
                weaponGroup.add(body);
                
                // Canon
                const barrelGeo = new THREE.CylinderGeometry(0.05, 0.05, 1, 8);
                const barrelMat = new THREE.MeshStandardMaterial({ color: 0x111111 });
                const barrel = new THREE.Mesh(barrelGeo, barrelMat);
                barrel.rotation.x = Math.PI / 2;
                barrel.position.set(0, 0, -1.5);
                weaponGroup.add(barrel);
                
                // Viseur
                const scopeGeo = new THREE.BoxGeometry(0.1, 0.15, 0.4);
                const scopeMat = new THREE.MeshStandardMaterial({ color: 0x00e5ff, emissive: 0x00e5ff, emissiveIntensity: 0.5 });
                const scope = new THREE.Mesh(scopeGeo, scopeMat);
                scope.position.set(0, 0.2, -0.5);
                weaponGroup.add(scope);
                
                weaponGroup.position.set(0.3, -0.3, -1);
            } else {
                // Corps du Bazooka
                const bodyGeo = new THREE.CylinderGeometry(0.15, 0.15, 2, 16);
                const bodyMat = new THREE.MeshStandardMaterial({ color: 0x556B2F, metalness: 0.5, roughness: 0.7 });
                const body = new THREE.Mesh(bodyGeo, bodyMat);
                body.rotation.x = Math.PI / 2;
                body.position.set(0, 0, -1);
                weaponGroup.add(body);
                
                // Ogive
                const headGeo = new THREE.ConeGeometry(0.2, 0.5, 16);
                const headMat = new THREE.MeshStandardMaterial({ color: 0xff0000, emissive: 0x550000 });
                const head = new THREE.Mesh(headGeo, headMat);
                head.rotation.x = -Math.PI / 2;
                head.position.set(0, 0, -2.25);
                weaponGroup.add(head);
                
                // Tube de visée
                const scopeGeo = new THREE.BoxGeometry(0.05, 0.1, 0.6);
                const scopeMat = new THREE.MeshStandardMaterial({ color: 0xff00c8, emissive: 0xff00c8, emissiveIntensity: 0.5 });
                const scope = new THREE.Mesh(scopeGeo, scopeMat);
                scope.position.set(0, 0.2, -1);
                weaponGroup.add(scope);

                weaponGroup.position.set(0.4, -0.4, -1.5);
            }
            
            camera.add(weaponGroup);
        }

        function onMouseDown(event) {
            if (event.button === 0) { // Clic gauche
                shoot();
            }
        }

        function shoot() {
            const now = Date.now();
            const stats = WEAPON_STATS[currentWeapon];
            
            if (now - lastShotTime < stats.fireRate) return;
            lastShotTime = now;

            // Effet de recul
            camera.rotation.x += stats.recoil;
            setTimeout(() => { camera.rotation.x -= stats.recoil; }, 50);

            // Flash
            muzzleFlash.material.opacity = 1;
            setTimeout(() => { muzzleFlash.material.opacity = 0; }, 50);

            // Projectile
            const bulletGeo = new THREE.SphereGeometry(stats.size * 0.1, 8, 8);
            const bulletMat = new THREE.MeshBasicMaterial({ color: stats.color });
            const bullet = new THREE.Mesh(bulletGeo, bulletMat);
            
            // Position de départ (depuis la caméra)
            bullet.position.copy(camera.position);
            bullet.position.y -= 0.2;
            
            // Direction
            const direction = new THREE.Vector3();
            camera.getWorldDirection(direction);
            bullet.userData = {
                velocity: direction.multiplyScalar(stats.speed),
                damage: stats.damage,
                life: 2.0 // secondes
            };
            
            scene.add(bullet);
            bullets.push(bullet);

            document.getElementById('status').innerText = `STATUT : TIR ${currentWeapon.toUpperCase()}`;
            setTimeout(() => document.getElementById('status').innerText = 'STATUT : Prêt', 300);
        }

        function onKeyDown(event) {
            if (event.key === '1') {
                currentWeapon = 'rifle';
                createWeaponModel();
            } else if (event.key === '2') {
                currentWeapon = 'bazooka';
                createWeaponModel();
            }
        }

        function onMouseMove(event) {
            // Rotation de la caméra (FPS)
            const movementX = event.movementX || 0;
            const movementY = event.movementY || 0;
            
            // Limiter la rotation verticale
            camera.rotation.y -= movementX * 0.002;
            camera.rotation.x -= movementY * 0.002;
            camera.rotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, camera.rotation.x));
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function updateBullets(delta) {
            for (let i = bullets.length - 1; i >= 0; i--) {
                const b = bullets[i];
                
                // Mouvement
                b.position.add(b.velocity.clone().multiplyScalar(delta));
                
                // Collision avec les cibles
                for (let j = targetBoxes.length - 1; j >= 0; j--) {
                    const target = targetBoxes[j];
                    const dist = b.position.distanceTo(target.position);
                    
                    if (dist < 1.2) {
                        // Impact !
                        explode(b.position, currentWeapon === 'bazooka');
                        
                        target.userData.health -= b.userData.damage;
                        if (target.userData.health <= 0) {
                            scene.remove(target);
                            targetBoxes.splice(j, 1);
                        }
                        
                        scene.remove(b);
                        bullets.splice(i, 1);
                        break;
                    }
                }
                
                // Durée de vie
                b.userData.life -= delta;
                if (b.userData.life <= 0) {
                    scene.remove(b);
                    bullets.splice(i, 1);
                }
            }
        }

        function explode(position, isBazooka) {
            // Flash d'explosion
            const overlay = document.getElementById('explosion-overlay');
            overlay.style.opacity = isBazooka ? '0.8' : '0.2';
            setTimeout(() => { overlay.style.opacity = '0'; }, 100);

            // Particules d'explosion
            const count = isBazooka ? 50 : 10;
            const geo = new THREE.BufferGeometry();
            const pos = new Float32Array(count * 3);
            const vel = [];
            
            for (let i = 0; i < count; i++) {
                pos[i*3] = position.x;
                pos[i*3+1] = position.y;
                pos[i*3+2] = position.z;
                vel.push(new THREE.Vector3(
                    (Math.random() - 0.5) * 20,
                    (Math.random() - 0.5) * 20,
                    (Math.random() - 0.5) * 20
                ));
            }
            
            geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
            const mat = new THREE.PointsMaterial({ color: isBazooka ? 0xffaa00 : 0xff3333, size: isBazooka ? 0.5 : 0.2 });
            const particles = new THREE.Points(geo, mat);
            scene.add(particles);
            
            let life = 1.0;
            const interval = setInterval(() => {
                life -= 0.05;
                const positions = particles.geometry.attributes.position.array;
                for (let i = 0; i < count; i++) {
                    positions[i*3] += vel[i].x * 0.05;
                    positions[i*3+1] += vel[i].y * 0.05;
                    positions[i*3+2] += vel[i].z * 0.05;
                    vel[i].y -= 0.5; // Gravité
                }
                particles.geometry.attributes.position.needsUpdate = true;
                mat.opacity = life;
                
                if (life <= 0) {
                    clearInterval(interval);
                    scene.remove(particles);
                    particles.geometry.dispose();
                    mat.dispose();
                }
            }, 16);
        }

        let clock = new THREE.Clock();

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();
            
            updateBullets(delta);
            
            // Animation de l'arme (bobbing)
            if (weaponGroup) {
                weaponGroup.position.y = (currentWeapon === 'rifle' ? -0.3 : -0.4) + Math.sin(Date.now() * 0.005) * 0.01;
            }

            renderer.render(scene, camera);
        }

        init();
    </script>
</body>
</html>
HTML_EOF

# ─── SERVEUR HTTP BASH ───
handle_request() {
    local request_line
    read -r request_line
    local path=$(echo "$request_line" | awk '{print $2}')
    while IFS= read -r line && [[ -n "$line" && "$line" != $'\r' ]]; do :; done

    if [[ "$path" == "/" || "$path" == "/index.html" ]]; then
        local len=$(wc -c < "$HTML_FILE")
        printf 'HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\nConnection: close\r\n\r\n' "$len"
        cat "$HTML_FILE"
    else
        printf 'HTTP/1.1 404 Not Found\r\n\r\n404'
    fi
}
export -f handle_request
export HTML_FILE

echo -e "  \033[1;32m[✓]\033[0m Moteur 3D prêt sur le port \033[1;36m$PORT\033[0m"
echo -e "  \033[1;32m[✓]\033[0m URL : \033[4mhttp://localhost:$PORT\033[0m"
echo -e "  \033[1;33m[1]\033[0m Fusil de précision (Cyan)"
echo -e "  \033[1;33m[2]\033[0m Bazooka explosif (Rose)"
echo -e "  \033[1;33mCLIC GAUCHE\033[0m pour tirer, \033[1;33mSOURIS\033[0m pour viser.\n"

trap 'echo -e "\n\033[1;31m[✗] Labo fermé.\033[0m"; rm -f "$HTML_FILE"; exit 0' INT TERM

if command -v xdg-open >/dev/null 2>&1; then
    sleep 1
    xdg-open "http://localhost:$PORT" &
fi

if command -v socat >/dev/null 2>&1; then
    socat TCP-LISTEN:$PORT,reuseaddr,fork EXEC:"bash -c 'handle_request'"
elif command -v nc >/dev/null 2>&1; then
    while true; do nc -l -p $PORT -c "bash -c 'handle_request'" 2>/dev/null || nc -l -p $PORT < /dev/null | bash -c 'handle_request'; done
else
    echo "Installer socat ou netcat."
    exit 1
fi

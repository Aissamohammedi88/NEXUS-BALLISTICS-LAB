const WEAPON_DATA = __WEAPONS_JSON__;
const CATEGORIES = __CATEGORIES_JSON__;

let scene, camera, renderer;
let currentWeaponIndex = 0;
let projectiles = [];
let targets = [];
let muzzleFlash = null;
let audioContext = null;
let lastShotTime = 0;
let targetsVisible = true;

// ═══════════════════════════════════════════════════════════════════════════
// AUDIO (Web Audio API)
// ═══════════════════════════════════════════════════════════════════════════

function initAudio() {
    if (!audioContext) {
        try {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) { console.warn('Audio indisponible'); }
    }
}

function playSound(type) {
    if (!audioContext) return;
    const now = audioContext.currentTime;
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);

    const profiles = {
        rifle:       [800, 100, 0.15, 0.25, 'sawtooth'],
        heavy_rifle: [500,  60, 0.25, 0.35, 'square'],
        sniper:      [600,  50, 0.35, 0.45, 'sawtooth'],
        smg:         [1000, 200, 0.06, 0.20, 'square'],
        shotgun:     [200,  40, 0.25, 0.40, 'square'],
        rocket:      [150,  30, 0.50, 0.30, 'square'],
        laser:       [2000, 500, 0.10, 0.18, 'sawtooth']
    };
    const p = profiles[type] || profiles.rifle;
    osc.type = p[4];
    osc.frequency.setValueAtTime(p[0], now);
    osc.frequency.exponentialRampToValueAtTime(p[1], now + p[2]);
    gain.gain.setValueAtTime(p[3], now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + p[2]);
    osc.start(now);
    osc.stop(now + p[2] + 0.02);
}

// ═══════════════════════════════════════════════════════════════════════════
// SCÈNE 3D
// ═══════════════════════════════════════════════════════════════════════════

function initScene() {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x05050a);
    scene.fog = new THREE.FogExp2(0x05050a, 0.012);

    camera = new THREE.PerspectiveCamera(75,
        window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 2, 8);
    camera.lookAt(0, 2, -10);

    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    document.body.appendChild(renderer.domElement);

    // Lumières
    scene.add(new THREE.AmbientLight(0x404060, 0.6));

    const dir = new THREE.DirectionalLight(0xffffff, 1.0);
    dir.position.set(20, 40, 20);
    scene.add(dir);

    const pt = new THREE.PointLight(0xff00c8, 1.5, 80);
    pt.position.set(0, 15, 0);
    scene.add(pt);

    // Grille + sol
    scene.add(new THREE.GridHelper(200, 100, 0xff00c8, 0x1a1a2a));

    const ground = new THREE.Mesh(
        new THREE.PlaneGeometry(200, 200),
        new THREE.MeshStandardMaterial({ color: 0x0a0a14, roughness: 0.9 })
    );
    ground.rotation.x = -Math.PI / 2;
    scene.add(ground);

    // Muzzle flash
    muzzleFlash = new THREE.Mesh(
        new THREE.SphereGeometry(0.4, 8, 8),
        new THREE.MeshBasicMaterial({
            color: 0xffaa00, transparent: true, opacity: 0
        })
    );
    scene.add(muzzleFlash);

    spawnTargets();
    updateWeaponDisplay();
    renderWeaponsList();

    window.addEventListener('resize', onWindowResize);
    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('wheel', onWheel, { passive: true });
    document.addEventListener('keydown', onKeyDown);

    animate();
}

function spawnTargets() {
    targets.forEach(t => scene.remove(t));
    targets = [];

    const geo = new THREE.BoxGeometry(2, 2, 2);
    for (let i = 0; i < 40; i++) {
        const mat = new THREE.MeshStandardMaterial({
            color: 0xff3333, emissive: 0x330000
        });
        const t = new THREE.Mesh(geo, mat);
        t.position.set(
            (Math.random() - 0.5) * 100,
            Math.random() * 12 + 1.5,
            -(Math.random() * 80 + 15)
        );
        t.userData = { health: 100, hitTimer: 0 };
        targets.push(t);
        scene.add(t);
    }
    updateStats();
}

// ═══════════════════════════════════════════════════════════════════════════
// TIR
// ═══════════════════════════════════════════════════════════════════════════

function shoot() {
    const w = WEAPON_DATA[currentWeaponIndex];
    const now = performance.now();
    if (now - lastShotTime < 1000 / w.fire_rate) return;
    lastShotTime = now;

    initAudio();
    playSound(w.sound || 'rifle');

    // Recul caméra
    camera.rotation.x += w.recoil * 0.4;
    setTimeout(() => { camera.rotation.x -= w.recoil * 0.4; }, 80);

    // Flash
    muzzleFlash.material.opacity = 1;
    const dirVec = new THREE.Vector3();
    camera.getWorldDirection(dirVec);
    muzzleFlash.position.copy(camera.position).add(dirVec.clone().multiplyScalar(2));
    setTimeout(() => { muzzleFlash.material.opacity = 0; }, 50);

    const pellets = w.pellets || 1;
    for (let p = 0; p < pellets; p++) {
        const spreadX = (Math.random() - 0.5) * w.spread;
        const spreadY = (Math.random() - 0.5) * w.spread;

        const geo = new THREE.SphereGeometry(w.blast_radius ? 0.5 : 0.18, 8, 8);
        const mat = new THREE.MeshBasicMaterial({
            color: new THREE.Color(w.color), transparent: true, opacity: 0.9
        });
        const proj = new THREE.Mesh(geo, mat);

        const d = new THREE.Vector3();
        camera.getWorldDirection(d);
        d.x += spreadX; d.y += spreadY; d.normalize();

        proj.position.copy(camera.position).add(d.clone().multiplyScalar(1.5));
        proj.position.y -= 0.2;

        proj.userData = {
            velocity: d.clone().multiplyScalar(w.speed * 0.1),
            damage: w.damage,
            blastRadius: w.blast_radius || 0,
            life: w.range / (w.speed * 0.1),
            color: w.color
        };

        scene.add(proj);
        projectiles.push(proj);
    }
    updateStats();
}

function updateProjectiles(delta) {
    for (let i = projectiles.length - 1; i >= 0; i--) {
        const p = projectiles[i];
        p.position.add(p.userData.velocity.clone().multiplyScalar(delta));
        p.userData.velocity.y -= 9.8 * delta;
        p.userData.velocity.multiplyScalar(0.998);
        p.userData.life -= delta;

        // Sol
        if (p.position.y <= 0) {
            explode(p.position, p.userData);
            scene.remove(p); projectiles.splice(i, 1);
            continue;
        }

        // Cibles
        let hit = false;
        for (let j = targets.length - 1; j >= 0; j--) {
            const t = targets[j];
            const dist = p.position.distanceTo(t.position);
            const threshold = p.userData.blastRadius > 0
                ? p.userData.blastRadius + 1.5 : 1.6;

            if (dist < threshold) {
                if (p.userData.blastRadius > 0) {
                    explode(p.position, p.userData);
                    applyAOE(p.position, p.userData.blastRadius, p.userData.damage);
                } else {
                    t.userData.health -= p.userData.damage;
                    t.userData.hitTimer = 0.25;
                    t.material.emissive.setHex(0xffaa00);
                    if (t.userData.health <= 0) {
                        scene.remove(t); targets.splice(j, 1);
                    }
                }
                scene.remove(p); projectiles.splice(i, 1);
                hit = true;
                break;
            }
        }
        if (hit) continue;

        if (p.userData.life <= 0) {
            scene.remove(p); projectiles.splice(i, 1);
        }
    }
    updateStats();
}

function explode(pos, data) {
    const count = data.blastRadius ? 40 : 12;
    const geo = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const velocities = [];

    for (let i = 0; i < count; i++) {
        positions[i*3] = pos.x;
        positions[i*3+1] = pos.y;
        positions[i*3+2] = pos.z;
        velocities.push(new THREE.Vector3(
            (Math.random() - 0.5) * 20,
            Math.random() * 12,
            (Math.random() - 0.5) * 20
        ));
    }
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const mat = new THREE.PointsMaterial({
        color: new THREE.Color(data.color || '#ff6600'),
        size: data.blastRadius ? 0.8 : 0.4,
        transparent: true
    });
    const particles = new THREE.Points(geo, mat);
    scene.add(particles);

    let life = 1.0;
    const timer = setInterval(() => {
        life -= 0.05;
        const arr = particles.geometry.attributes.position.array;
        for (let i = 0; i < count; i++) {
            arr[i*3] += velocities[i].x * 0.05;
            arr[i*3+1] += velocities[i].y * 0.05;
            arr[i*3+2] += velocities[i].z * 0.05;
            velocities[i].y -= 0.4;
        }
        particles.geometry.attributes.position.needsUpdate = true;
        mat.opacity = life;
        if (life <= 0) {
            clearInterval(timer);
            scene.remove(particles);
            geo.dispose(); mat.dispose();
        }
    }, 16);
}

function applyAOE(pos, radius, baseDmg) {
    for (let i = targets.length - 1; i >= 0; i--) {
        const t = targets[i];
        const d = t.position.distanceTo(pos);
        if (d < radius) {
            const dmg = Math.floor(baseDmg * (1 - d / radius));
            t.userData.health -= dmg;
            t.userData.hitTimer = 0.25;
            t.material.emissive.setHex(0xffaa00);
            if (t.userData.health <= 0) {
                scene.remove(t); targets.splice(i, 1);
            }
        }
    }
}

function updateTargets(delta) {
    targets.forEach(t => {
        if (t.userData.hitTimer > 0) {
            t.userData.hitTimer -= delta;
            if (t.userData.hitTimer <= 0) {
                t.material.emissive.setHex(0x330000);
            }
        }
    });
}


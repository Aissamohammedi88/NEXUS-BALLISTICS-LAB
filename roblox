let yaw = 0, pitch = 0;

function onMouseMove(e) {
    if (e.buttons === 2) {
        yaw -= e.movementX * 0.003;
        pitch -= e.movementY * 0.003;
        pitch = Math.max(-1.2, Math.min(1.2, pitch));
        const r = 8;
        camera.position.x = Math.sin(yaw) * r;
        camera.position.z = Math.cos(yaw) * r;
        camera.position.y = 2 + Math.sin(pitch) * 4;
        camera.lookAt(0, 2, -20);
    }
}

function onMouseDown(e) {
    if (e.button === 0) shoot();
}

function onWheel(e) {
    if (e.deltaY > 0) {
        currentWeaponIndex = (currentWeaponIndex + 1) % WEAPON_DATA.length;
    } else {
        currentWeaponIndex = (currentWeaponIndex - 1 + WEAPON_DATA.length)
            % WEAPON_DATA.length;
    }
    updateWeaponDisplay();
}

function onKeyDown(e) {
    if (e.key >= '1' && e.key <= '9') {
        const ci = parseInt(e.key) - 1;
        if (ci < CATEGORIES.length) {
            const fi = WEAPON_DATA.findIndex(w => w.category === CATEGORIES[ci]);
            if (fi >= 0) { currentWeaponIndex = fi; updateWeaponDisplay(); }
        }
    }
    if (e.key.toLowerCase() === 'b') {
        targetsVisible = !targetsVisible;
        targets.forEach(t => t.visible = targetsVisible);
    }
    if (e.key.toLowerCase() === 'r') {
        spawnTargets();
    }
}


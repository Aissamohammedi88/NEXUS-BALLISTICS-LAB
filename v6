    padding: 10px 16px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--dim);
    transition: all 0.2s;
}
.map-btn:hover {
    border-color: var(--accent);
    color: var(--text);
}
.map-btn.active {
    background: linear-gradient(135deg, var(--accent), var(--purple));
    color: #000;
    border: none;
}

/* ═════════════════════════════════════════════════════════════════════════ */
/* LISTE ARMES LATERALE */
/* ═════════════════════════════════════════════════════════════════════════ */
.weapons-sidebar {
    position: absolute;
    top: 76px;
    right: 24px;
    width: 280px;
    max-height: calc(100vh - 220px);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    z-index: 800;
    overflow-y: auto;
    backdrop-filter: blur(30px);
}
.weapons-sidebar::-webkit-scrollbar { width: 6px; }
.weapons-sidebar::-webkit-scrollbar-track { background: transparent; }
.weapons-sidebar::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
}
.sidebar-header {
    font-size: 12px;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
}
.weapon-category-title {
    color: var(--accent2);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 12px 0 8px;
    border-top: 1px solid var(--border);
}
.weapon-list-item {
    padding: 12px;
    margin: 6px 0;
    border-radius: 10px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.weapon-list-item:hover {
    background: rgba(255,255,255,0.05);
}
.weapon-list-item.active {
    background: rgba(0,255,136,0.1);
    border-color: var(--accent2);
}
.weapon-list-name {
    font-weight: 600;
    font-size: 13px;
}
.weapon-list-rank {
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

